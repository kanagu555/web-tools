# Next.js Environment Variables
# Copy this file to .env.local and fill in your actual values

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="KodeKit"
NEXT_PUBLIC_APP_DESCRIPTION="Developer Tools Collection"

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Database Configuration (Supabase)
POSTGRES_URL=your_postgres_url_here
POSTGRES_PRISMA_URL=your_postgres_prisma_url_here
POSTGRES_URL_NON_POOLING=your_postgres_url_non_pooling_here
POSTGRES_USER=postgres
POSTGRES_HOST=your_postgres_host_here
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DATABASE=postgres

# Third-party API Keys
NEXT_PUBLIC_WEB3FORMS_KEY=your_web3forms_key_here
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Analytics and Monitoring
NEXT_PUBLIC_GA_MEASUREMENT_ID=your_google_analytics_id_here
NEXT_PUBLIC_GOOGLE_ADSENSE_ID=your_google_adsense_id_here
NEXT_PUBLIC_CLARITY_PROJECT_ID=your_clarity_project_id_here

# Build Configuration
ANALYZE=false
BUILD_STANDALONE=false
NODE_ENV=development

# Security
SUPABASE_JWT_SECRET=your_jwt_secret_here
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Firebase Configuration
# Get these values from your Firebase project settings > General > Your apps > Firebase SDK snippet > Config

# Required Firebase settings
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Optional Firebase settings
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# App Configuration
NEXT_PUBLIC_APP_URL=https://www.kodekit.in

# Instructions:
# 1. Copy this file to .env.local
# 2. Replace all placeholder values with your actual Firebase configuration
# 3. Never commit .env.local to version control
# 4. For production, set these environment variables in your deployment platform (Vercel, Netlify, etc.)
