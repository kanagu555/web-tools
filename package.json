{
  "name": "kodekit-nextjs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:analyze": "cross-env ANALYZE=true next build",
    "build:standalone": "cross-env BUILD_STANDALONE=true next build",
    "start": "next start",
    "start:prod": "cross-env NODE_ENV=production next start",
    "lint": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint .",
    "lint:fix": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "echo \"No tests specified\" && exit 0",
    "clean": "rimraf .next out dist",
    "export": "next build && next export",
    "serve": "npx serve@latest out",
    "postbuild": "next-sitemap",
    "validate": "node scripts/validate-build.js",
    "analyze:bundle": "node scripts/analyze-bundle.js analyze",
    "analyze:size": "node scripts/analyze-bundle.js size",
    "analyze:check": "node scripts/analyze-bundle.js check",
    "seo:validate": "node scripts/seo-validation.js",
    "seo:test-meta": "node scripts/test-meta-tags.js",
    "seo:test-structured": "node scripts/validate-structured-data.js",
    "seo:test-live": "node scripts/test-seo-live.js",
    "seo:test-all": "yarn seo:validate && yarn seo:test-meta && yarn seo:test-structured",
    "cleanup": "node scripts/cleanup-project.js",
    "cleanup:dry-run": "node scripts/cleanup-project.js --dry-run",
    "prebuild": "yarn clean",
    "predeploy": "yarn validate"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.17.1",
    "@mui/material": "^5.14.12",
    "@mui/material-nextjs": "^7.2.0",
    "@mui/x-date-pickers": "^8.4.0",
    "@next/third-parties": "^14.2.15",
    "@supabase/supabase-js": "^2.52.1",
    "@vercel/speed-insights": "^1.2.0",
    "clsx": "^2.1.0",
    "date-fns": "^4.1.0",
    "firebase": "^10.13.0",
    "framer-motion": "^10.16.4",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.1",
    "jspdf-autotable": "^5.0.2",
    "jszip": "^3.10.1",
    "katex": "^0.16.22",
    "lucide-react": "^0.344.0",
    "minimatch": "^10.0.3",
    "next": "^14.2.15",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "5.4.54",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.1",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.2.1",
    "react-dropzone": "^14.3.8",
    "react-helmet": "^6.1.0",
    "react-markdown": "^10.1.0",
    "react-share": "^5.2.2",
    "react-syntax-highlighter": "^15.6.1",
    "recharts": "^2.15.3",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.2.15",
    "@svgr/webpack": "8.1.0",
    "@types/jszip": "^3.4.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/react-helmet": "^6.1.11",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "autoprefixer": "^10.4.18",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.15",
    "next-pwa": "5.6.0",
    "next-sitemap": "4.2.3",
    "postcss": "^8.4.35",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3"
  }
}